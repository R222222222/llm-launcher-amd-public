{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "enabled_providers": ["llama8421"],
  "provider": {
    "llama8421": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server 8421",
      "options": {
        "baseURL": "http://127.0.0.1:8421/v1",
        "apiKey": "local"
      },
      "models": {
        "Qwen3.6-27B-Fable-Fus-711-UnHeretic-NM-DAU-NEO-MAX-NEO-MTP-Q4_K_M": {
          "name": "Qwen3.6 27B MTP local",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "llama8421/Qwen3.6-27B-Fable-Fus-711-UnHeretic-NM-DAU-NEO-MTP-Q4_K_M",
  "small_model": "llama8421/Qwen3.6-27B-Fable-Fus-711-UnHeretic-NM-DAU-NEO-MTP-Q4_K_M",
  "mcp": {
    "duckduckgo": {
      "type": "local",
      "command": [
        "/path/to/.local/bin/uvx",
        "duckduckgo-mcp-server"
      ],
      "enabled": true,
      "timeout": 10000
    }
  },
  "permission": {
    "*": "allow",
    "bash": "deny",
    "edit": "deny",
    "write": "deny",
    "patch": "deny",
    "external_directory": "deny"
  }
}
