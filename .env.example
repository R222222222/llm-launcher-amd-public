# Safe local defaults. Copy to .env and export/source it before starting the app.
LLM_LAUNCHER_HOST=127.0.0.1
LLM_LAUNCHER_LLAMA_HOST=127.0.0.1

# MCP is disabled by default. Keep remote MCP disabled unless the environment
# is explicitly controlled and the command-execution risk is understood.
LLM_LAUNCHER_ENABLE_MCP=0
LLM_LAUNCHER_ALLOW_REMOTE_MCP=0

# Optional overrides (leave commented to use portable defaults).
# LLM_LAUNCHER_MODELS_DIR=/path/to/models
# LLM_LAUNCHER_LLAMA_CPP_BIN=/path/to/llama.cpp/build/bin
# LLM_LAUNCHER_LMS_PATH=/path/to/lms

# Tailscale example: use an address belonging to your own environment.
# TAILSCALE_IP=<tailscale-ip>
# LLM_LAUNCHER_HOST=$TAILSCALE_IP
# LLM_LAUNCHER_LLAMA_HOST=$TAILSCALE_IP
